---
import Base from '../../layouts/Base.astro';
import breaksData from '../../data/breaks.json';

// Only show visible writeup/legacy entries — no xposts, no posts
const breaks = breaksData
  .filter(b => b.visible !== false)
  .filter(b => {
    const t = b.type || (b.tldr ? 'writeup' : 'legacy');
    return t === 'writeup' || t === 'legacy';
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const base = import.meta.env.BASE_URL;

// Number entries starting from #1
const writeupNumbers = new Map();
breaks.forEach((brk, i) => writeupNumbers.set(brk.id, i + 1));

// Spoiler rendering
function renderSpoiler(text: string): string {
  if (!text) return '';
  return text.replace(
    /\[\[SPOILER\]\]([\s\S]*?)\[\[\/SPOILER\]\]/g,
    '<span class="spoiler"><span class="spoiler-content">$1</span><span class="spoiler-label">hover to reveal</span></span>'
  );
}

// Locked content rendering
function renderLocked(text: string, id: string): string {
  if (!text) return '';
  let counter = 0;
  return text.replace(
    /\[\[LOCKED:([a-f0-9]+)\]\]([\s\S]*?)\[\[\/LOCKED\]\]/g,
    (match, hash, content) => {
      const lockId = `${id}-lock-${counter++}`;
      const isShort = content.length < 200 && !content.includes('\n');
      if (isShort) {
        return `<span class="locked-inline" id="${lockId}" data-hash="${hash}"><span class="locked-inline-trigger" onclick="promptUnlock('${lockId}')">🔐 [locked]</span><span class="locked-inline-content">${content}</span></span>`;
      } else {
        return `<div class="locked" id="${lockId}" data-hash="${hash}">
          <div class="locked-overlay">
            <span class="locked-icon">🔐</span>
            <span class="locked-text">Password Protected</span>
            <div class="locked-input">
              <input type="password" placeholder="Password" onkeypress="if(event.key==='Enter')unlockContent('${lockId}')">
              <button onclick="unlockContent('${lockId}')">Unlock</button>
            </div>
            <div class="locked-error"></div>
          </div>
          <div class="locked-content">${content}</div>
        </div>`;
      }
    }
  );
}

function renderProtected(text: string, id: string): string {
  if (!text) return '';
  return renderLocked(renderSpoiler(text), id);
}
---
<Base title="Gray Swan Breaks — elvec1o">
  <h1>Gray Swan Breaks</h1>
  <p class="subtitle">{breaks.length} documented breaks</p>

  <div class="breaks-nav">
    <strong>Jump to:</strong>
    {breaks.map((brk) => (
      <a href={`#${brk.id}`} class="nav-link">#{writeupNumbers.get(brk.id)} — {brk.name}</a>
    ))}
  </div>

  {breaks.map((brk) => {
    const entryType = brk.type || (brk.tldr ? 'writeup' : 'legacy');
    return (
      <article class="break-entry" id={brk.id}>

        <header class="break-header">
          <div class="break-meta">
            <span class="priority">#{writeupNumbers.get(brk.id)}</span>
            <span class="category">{brk.category}</span>
            <span class="technique">{brk.technique}</span>
            <span class="date">{brk.date}</span>
            {brk.wip && <span class="wip-badge">WIP</span>}
          </div>
          <h2>{brk.name}</h2>
        </header>

        {brk.tldr && (
          <div class="tldr">
            <strong>TL;DR:</strong> {brk.tldr}
          </div>
        )}

        {brk.images && brk.images.length > 0 && brk.images.map((img: string, idx: number) => (
          <div class="screenshot-wrap">
            <img src={`${base}/img/${img}`} alt={`${brk.name} screenshot ${idx + 1}`} class="screenshot" />
          </div>
        ))}

        {/* WRITEUP FORMAT */}
        {entryType === 'writeup' && (
          <div class="break-body">
            {brk.summary && (
              <div class="summary-section">
                <h3>Summary</h3>
                <p>{brk.summary}</p>
              </div>
            )}

            {brk.userPrompt && (
              <div class="prompt-section">
                <h3>Prompt Used</h3>
                <div class="quote-user" set:html={renderProtected(brk.userPrompt, brk.id + '-user')} />
              </div>
            )}

            {brk.modelResponse && (
              <div class="response-section">
                <h3>Model Response</h3>
                <div class="quote-model" set:html={renderProtected(brk.modelResponse, brk.id + '-model')} />
              </div>
            )}

            {brk.modelThinking && (
              <div class="thinking-section">
                <h3>Model Thinking</h3>
                <div class="quote-thinking">{brk.modelThinking}</div>
              </div>
            )}

            {brk.considerations && (
              <div class="considerations">
                <strong>Considerations:</strong> {brk.considerations}
              </div>
            )}
          </div>
        )}

        {/* LEGACY FORMAT */}
        {entryType === 'legacy' && (
          <div class="break-body">
            {brk.challenge && <p><strong>Challenge:</strong> {brk.challenge}</p>}
            {brk.insight && <div class="insight">{brk.insight}</div>}
            {brk.prompt && (
              <>
                <p><strong>Prompt:</strong></p>
                <pre>{brk.prompt}</pre>
              </>
            )}
            {brk.result && <p><strong>Result:</strong> {brk.result}</p>}
          </div>
        )}

        <footer class="break-footer">
          {brk.url && <a href={brk.url} target="_blank" class="btn-grayswan">→ View on Gray Swan</a>}
          <a href="#top" class="back-top">↑ Back to top</a>
        </footer>

      </article>
    );
  })}

  <p class="back-home"><a href={`${base}/`}>← Back home</a></p>
</Base>

<style>
  .subtitle {
    color: #666;
    margin-top: -0.5rem;
    margin-bottom: 2rem;
  }

  .breaks-nav {
    background: #f5f5f5;
    padding: 1rem;
    margin-bottom: 2rem;
    border: 1px solid #ddd;
    font-size: 0.85rem;
  }
  .breaks-nav strong {
    display: block;
    margin-bottom: 0.5rem;
  }
  .nav-link {
    display: block;
    margin: 0.2rem 0;
    color: #111;
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    background: #fff;
    border: 1px solid #ddd;
    white-space: nowrap;
    overflow: visible;
  }
  .nav-link:hover {
    background: #111;
    color: #fff;
  }

  .break-entry {
    border: 1px solid #ddd;
    margin-bottom: 2rem;
    background: #fff;
  }

  .break-header {
    background: #1a1a1a;
    color: #fff;
    padding: 1.5rem;
  }
  .break-header h2 {
    color: #fff;
    margin: 0.5rem 0 0;
    border: none;
    font-size: 1.2rem;
  }
  .break-meta {
    display: flex;
    gap: 0.75rem;
    font-size: 0.8rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .break-meta span {
    background: rgba(255,255,255,0.1);
    padding: 0.2rem 0.5rem;
  }
  .priority {
    background: #e74c3c !important;
    font-weight: bold;
  }
  .category {
    background: #2980b9 !important;
  }
  .wip-badge {
    display: inline-block;
    background: #ff9800;
    color: #fff;
    font-size: 0.6rem;
    font-weight: bold;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .tldr {
    background: #fff8e1;
    padding: 1rem 1.5rem;
    border-left: 4px solid #ffc107;
    font-size: 0.95rem;
  }

  .break-body {
    padding: 1.5rem;
    line-height: 1.8;
  }
  .break-body h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #888;
    margin: 1.5rem 0 0.5rem;
    border: none;
  }
  .break-body h3:first-child {
    margin-top: 0;
  }
  .break-body p {
    margin: 0.5rem 0;
  }

  .screenshot-wrap {
    padding: 1rem 1.5rem 0;
  }
  .screenshot {
    max-width: 100%;
    border: 1px solid #ddd;
  }

  .quote-user {
    background: #f0f4ff;
    border-left: 3px solid #4a6fa5;
    padding: 1rem;
    font-family: monospace;
    font-size: 0.85rem;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .quote-model {
    background: #f0fff4;
    border-left: 3px solid #27ae60;
    padding: 1rem;
    font-size: 0.9rem;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .quote-thinking {
    background: #fafafa;
    border-left: 3px solid #bbb;
    padding: 1rem;
    font-style: italic;
    font-size: 0.85rem;
    color: #555;
  }
  .considerations {
    background: #f9f9f9;
    border: 1px solid #eee;
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    margin-top: 1rem;
  }
  .insight {
    background: #f9f9f9;
    border-left: 3px solid #ddd;
    padding: 0.75rem 1rem;
    margin: 0.5rem 0;
  }
  pre {
    background: #1a1a1a;
    color: #0f0;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.8rem;
    white-space: pre-wrap;
  }

  .break-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: #f9f9f9;
    border-top: 1px solid #eee;
    font-size: 0.85rem;
  }
  .btn-grayswan {
    color: #e74c3c;
    text-decoration: none;
    font-weight: bold;
  }
  .btn-grayswan:hover { text-decoration: underline; }
  .back-top { color: #999; }

  .back-home { margin-top: 2rem; }

  /* Spoiler */
  .spoiler { position: relative; display: inline; }
  .spoiler-content { filter: blur(4px); transition: filter 0.2s; cursor: pointer; }
  .spoiler:hover .spoiler-content { filter: none; }
  .spoiler-label {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.75rem; color: #888; pointer-events: none;
  }
  .spoiler:hover .spoiler-label { display: none; }

  /* Locked */
  .locked { position: relative; }
  .locked-content { display: none; }
  .locked.unlocked .locked-overlay { display: none; }
  .locked.unlocked .locked-content { display: block; }
  .locked-overlay {
    background: #f5f5f5; border: 1px dashed #ccc;
    padding: 1.5rem; text-align: center;
  }
  .locked-icon { font-size: 1.5rem; display: block; margin-bottom: 0.5rem; }
  .locked-input { margin-top: 1rem; display: flex; gap: 0.5rem; justify-content: center; }
  .locked-input input { padding: 0.4rem 0.8rem; border: 1px solid #ddd; font-family: inherit; }
  .locked-input button { padding: 0.4rem 0.8rem; background: #111; color: #fff; border: none; cursor: pointer; font-family: inherit; }
  .locked-error { color: #e74c3c; font-size: 0.8rem; margin-top: 0.5rem; }
  .locked-inline { display: inline; }
  .locked-inline-trigger { cursor: pointer; color: #e74c3c; }
  .locked-inline-content { display: none; }
  .locked-inline.unlocked .locked-inline-trigger { display: none; }
  .locked-inline.unlocked .locked-inline-content { display: inline; }
</style>

<script>
  function simpleHash(str) {
    let hash = 0;
    for (let i = 0; i < str.length; i++) {
      const char = str.charCodeAt(i);
      hash = ((hash << 5) - hash) + char;
      hash = hash & hash;
    }
    return Math.abs(hash).toString(16);
  }

  function unlockContent(lockId) {
    const container = document.getElementById(lockId);
    const input = container.querySelector('input');
    const errorDiv = container.querySelector('.locked-error');
    const password = input.value;
    const expectedHash = container.dataset.hash;
    if (simpleHash(password) === expectedHash) {
      container.classList.add('unlocked');
      errorDiv.textContent = '';
    } else {
      errorDiv.textContent = 'Wrong password';
      input.value = '';
    }
  }

  function promptUnlock(lockId) {
    const container = document.getElementById(lockId);
    const expectedHash = container.dataset.hash;
    const password = prompt('Enter password to unlock:');
    if (password && simpleHash(password) === expectedHash) {
      container.classList.add('unlocked');
    } else if (password) {
      alert('Wrong password');
    }
  }

  window.unlockContent = unlockContent;
  window.promptUnlock = promptUnlock;
</script>
