---
import Base from '../../layouts/Base.astro';
import observationsData from '../../data/observations.json';

const observations = observationsData.sort((a, b) => a.priority - b.priority);
const base = import.meta.env.BASE_URL;

function renderMarkdown(text: string): string {
  if (!text) return '';
  return text
    .replace(/^### (.*$)/gim, '<h4>$1</h4>')
    .replace(/^## (.*$)/gim, '<h3>$1</h3>')
    .replace(/^# (.*$)/gim, '<h2>$1</h2>')
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>')
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/^- (.*$)/gim, '<li>$1</li>')
    .replace(/\n\n/g, '</p><p>')
    .replace(/\n/g, '<br>');
}
---
<Base title="Behavioural Observations — elvec1o">
  <h1>Behavioural Observations</h1>
  <p class="subtitle">{observations.length} documented patterns, anomalies, and model behaviours</p>

  <div class="observations-nav">
    <strong>Jump to:</strong>
    {observations.map((o, i) => (
      <a href={`#${o.id}`} class="nav-link">#{o.priority + 1} — {o.title}</a>
    ))}
  </div>

  {observations.map((obs, i) => {
    return (
      <article class="observation" id={obs.id}>
        <header class="observation-header">
          <div class="observation-meta">
            <span class="priority">#{obs.priority + 1}</span>
            <span class="target">{obs.target}</span>
            <span class="technique">{obs.technique}</span>
            <span class="date">{obs.date}</span>
          </div>
          <h2>{obs.title}</h2>
          <span class="type-tag">{obs.pubValue}</span>
        </header>

        <div class="tldr">
          <strong>TL;DR:</strong> {obs.tldr}
        </div>

        {obs.url && (
          <div class="observation-actions">
            <a href={obs.url} target="_blank" class="btn btn-observation">
              👁 Full Writeup
            </a>
          </div>
        )}

        <div class="observation-content" set:html={renderMarkdown(obs.content)} />

        {obs.images && obs.images.length > 0 && (
          <div class="observation-images">
            {obs.images.map((img: string) => (
              <img src={`${base}${img}`} alt={obs.title} class="screenshot" />
            ))}
          </div>
        )}

        <footer class="observation-footer">
          <a href="#top" class="back-top">↑ Back to top</a>
        </footer>
      </article>
    );
  })}

  <p class="back-home"><a href={`${base}/`}>← Back home</a></p>
</Base>

<style>
  .subtitle {
    color: #666;
    margin-top: -0.5rem;
    margin-bottom: 2rem;
  }

  .observations-nav {
    background: #f5f5f5;
    padding: 1rem;
    margin-bottom: 2rem;
    border: 1px solid #ddd;
    font-size: 0.85rem;
  }
  .observations-nav strong {
    display: block;
    margin-bottom: 0.5rem;
  }
  .nav-link {
    display: block;
    margin: 0.2rem 0;
    color: #111;
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    background: #fff;
    border: 1px solid #ddd;
  }
  .nav-link:hover {
    background: #111;
    color: #fff;
  }

  .observation {
    border: 1px solid #ddd;
    margin-bottom: 2rem;
    background: #fff;
  }

  .observation-header {
    background: #1a1a2e;
    color: #fff;
    padding: 1.5rem;
  }
  .observation-header h2 {
    color: #fff;
    margin: 0.5rem 0;
    border: none;
  }
  .observation-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    flex-wrap: wrap;
  }
  .observation-meta span {
    background: rgba(255,255,255,0.1);
    padding: 0.2rem 0.5rem;
  }
  .priority {
    background: #e040fb !important;
    font-weight: bold;
  }
  .target {
    background: #7c4dff !important;
  }
  .type-tag {
    display: inline-block;
    margin-top: 0.6rem;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    padding: 0.2rem 0.7rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: #fff;
  }

  .tldr {
    background: #f3e5f5;
    padding: 1rem 1.5rem;
    border-left: 4px solid #ab47bc;
    font-size: 0.95rem;
  }

  .observation-actions {
    display: flex;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    background: #f9f9f9;
    border-bottom: 1px solid #eee;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 1rem;
    font-family: inherit;
    font-size: 0.85rem;
    text-decoration: none;
    border: 1px solid #ddd;
    background: #fff;
    color: #111;
    cursor: pointer;
  }
  .btn:hover {
    background: #f5f5f5;
  }
  .btn-try {
    background: #4caf50;
    color: #fff;
    border-color: #4caf50;
    font-weight: bold;
  }
  .btn-try:hover {
    background: #388e3c;
  }
  .btn-observation {
    background: #ab47bc;
    color: #fff;
    border-color: #ab47bc;
    font-weight: bold;
  }
  .btn-observation:hover {
    background: #8e24aa;
    color: #fff;
  }

  .observation-content {
    padding: 1.5rem;
    line-height: 1.8;
  }
  .observation-content h2, .observation-content h3, .observation-content h4 {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .observation-content h3 {
    font-size: 1.1rem;
    color: #333;
  }
  .observation-content h4 {
    font-size: 1rem;
    color: #555;
  }
  .observation-content pre {
    background: #1a1a1a;
    color: #0f0;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.85rem;
  }
  .observation-content code {
    background: #f0f0f0;
    padding: 0.1rem 0.3rem;
    font-size: 0.9em;
  }
  .observation-content pre code {
    background: transparent;
    padding: 0;
  }
  .observation-content li {
    margin-left: 1.5rem;
    margin-bottom: 0.3rem;
  }

  .observation-images {
    padding: 0 1.5rem 1.5rem;
  }
  .screenshot {
    max-width: 100%;
    border: 1px solid #ddd;
    margin-top: 1rem;
  }

  .observation-footer {
    padding: 1rem 1.5rem;
    background: #f9f9f9;
    border-top: 1px solid #eee;
    text-align: right;
  }
  .back-top {
    font-size: 0.85rem;
    color: #666;
  }

  .back-home {
    margin-top: 2rem;
  }

</style>

